{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardcompute.org/foundry/schema/common.schema.json",
  "title": "Foundry common definitions",
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$",
          "description": "DNS-safe identifier used in resource names."
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "domain": { "type": "string" },
        "repository": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "propertyNames": { "pattern": "^[a-z0-9]([a-z0-9._/-]*[a-z0-9])?$" }
    },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
    },
    "provider": {
      "type": "string",
      "enum": ["aws", "gcp", "azure", "digitalocean"]
    }
  }
}
